[proxy]
listen = "127.0.0.1:6790"
vault = "1password"
log_level = "warn"

[[routes]]
host = "api.anthropic.com"
header_name = "x-api-key"
type = "header"
secret_ref = "anthropic-api-key"

[[routes]]
host = "api.openai.com"
header_name = "Authorization"
type = "header"
secret_ref = "openai-api-key"
scheme = "Bearer"

