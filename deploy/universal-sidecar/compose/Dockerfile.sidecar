# Universal Sidecar image (non-root)
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    KEPRIX_SIDECAR_HOST=0.0.0.0 \
    KEPRIX_SIDECAR_PORT=3360 \
    KEPRIX_SIDECAR_ALLOW_PUBLIC=1

WORKDIR /app

# Install package from repository context (adjust if using published wheel).
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir . \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin keprix \
    && chown -R keprix:keprix /app

USER keprix

EXPOSE 3360

CMD ["python", "-m", "keprix.universal_sidecar.app"]
