# Example EnvironmentFile for bare-metal systemd profile.
# Copy to /etc/keprix.env (mode 0600, root:keprix).
# Generate secrets with: bash scripts/generate-production-env.sh

KEPRIX_INSTANCE_URL=https://app.example.com
KEPRIX_ALLOWED_ORIGINS=https://app.example.com
KEPRIX_FRONTEND_URL=https://app.example.com
KEPRIX_TRUSTED_PROXIES=127.0.0.1,::1
BACKEND_PORT=3333
KEPRIX_LOG_LEVEL=info
# KEPRIX_LOGS_DIR is set by the unit; override if needed.
# KEPRIX_DATABASE_URL=postgresql+asyncpg://keprix:REPLACE_ME@127.0.0.1:5432/keprix
# KEPRIX_REDIS_URL=redis://:REPLACE_ME@127.0.0.1:6379
# KEPRIX_JWT_SECRET=
# KEPRIX_SESSION_SECRET=
# KEPRIX_VAULT_KEY=
# KEPRIX_HANDOFF_SECRET=
