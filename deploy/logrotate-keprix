# /etc/logrotate.d/keprix
@KEPRIX_HOME@/logs/*.log {
  daily
  rotate 14
  compress
  delaycompress
  missingok
  notifempty
  copytruncate
  su @KEPRIX_USER@ @KEPRIX_USER@
}
/var/log/caddy/keprix-access.log {
  daily
  rotate 14
  compress
  delaycompress
  missingok
  notifempty
  sharedscripts
  postrotate
    systemctl reload caddy >/dev/null 2>&1 || true
  endscript
}
