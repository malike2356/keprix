# Keprix frontend environment
# Leave empty to use Next.js rewrites to the local backend (see next.config.ts)
NEXT_PUBLIC_CE_API_URL=
NEXT_PUBLIC_API_URL=http://localhost:3333
# MCP admin API (servers, catalog, auto-spawn). Defaults to NEXT_PUBLIC_API_URL when unset.
# Use http://127.0.0.1:9119 when running the legacy dashboard web_server instead of main API.
# NEXT_PUBLIC_MCP_API_URL=http://localhost:3333
# NEXT_PUBLIC_DASHBOARD_API_URL=http://127.0.0.1:9119
# Published MkDocs site (Prompt 34). Default: GitHub Pages.
# Same-origin MkDocs output (built by scripts/build-docs.sh). Optional external override:
# NEXT_PUBLIC_DOCS_URL=/guide
