{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fleetz sidecar schemas",
  "definitions": {
    "result_envelope": {
      "type": "object",
      "required": ["fleet_id", "value_kind", "confidence"],
      "properties": {
        "fleet_id": { "type": "string" },
        "vehicle_id": { "type": ["string", "null"] },
        "event_ids": { "type": "array", "items": { "type": "string" } },
        "freshness": { "type": "object" },
        "sensor_quality": { "type": "object" },
        "units": { "type": "object" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "value_kind": { "enum": ["observed", "derived", "inferred", "calculated"] }
      }
    },
    "telemetry_query": {
      "type": "object",
      "required": ["fleet_id", "vehicle_id", "start_epoch_s", "end_epoch_s"],
      "properties": {
        "fleet_id": { "type": "string" },
        "vehicle_id": { "type": "string" },
        "start_epoch_s": { "type": "number" },
        "end_epoch_s": { "type": "number" },
        "resolution": { "type": "string" },
        "max_points": { "type": "integer", "maximum": 500 },
        "fields": { "type": "array", "items": { "type": "string" } },
        "cursor": { "type": ["string", "null"] }
      }
    }
  }
}
