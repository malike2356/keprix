# Keprix - Environment Configuration
# Copy to .env and fill in your values. Never commit .env.
#
# All Keprix-specific variables use the KEPRIX_ prefix (uppercase).
# Provider API keys use their canonical upstream names so the same .env
# works with local model servers without modification.

# ============================================================
# Product
# ============================================================

KEPRIX_VERSION=0.1.0

# ============================================================
# Developer Mode
# ============================================================

# Set automatically by 'keprix init' when you confirm you are the owner.
# Do not set manually.
KEPRIX_DEVELOPER_MODE=false

# ============================================================
# LLM Providers
# ============================================================

KEPRIX_DEFAULT_PROVIDER=auto

# Web chat: inject read-only codebase map + docs into the system prompt (true/false).
KEPRIX_CODEBASE_AWARENESS=true
# Allow the agent to spawn MCP servers from the built-in catalog during tasks.
# When unset, falls back to mcp.auto_spawn_enabled in config.yaml (toggle via /admin/mcp).
KEPRIX_AUTO_MCP_SPAWN=false
# Optional override when the API runs outside the install directory.
# KEPRIX_REPO_ROOT=/path/to/keprix

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
LM_STUDIO_URL=http://host.docker.internal:1234/v1
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# ============================================================
# Database
# ============================================================

KEPRIX_DATABASE_URL=postgresql+asyncpg://keprix:changeme@localhost:5432/keprix
POSTGRES_PASSWORD=changeme
POSTGRES_BIND=127.0.0.1
POSTGRES_HOST_PORT=5432

# ============================================================
# Redis Cache
# ============================================================

KEPRIX_REDIS_URL=redis://:changeme@localhost:6379
REDIS_PASSWORD=changeme
REDIS_BIND=127.0.0.1
REDIS_HOST_PORT=6379

# ============================================================
# Web Search (SearXNG - self-hosted)
# ============================================================
# Start SearXNG: docker compose -f docker-compose.searxng.yml up -d
# Then set SEARXNG_URL in Settings -> Web search (or here for non-UI setups).

SEARXNG_BIND=127.0.0.1
SEARXNG_PORT=8080
SEARXNG_URL=http://localhost:8080
KEPRIX_SEARXNG_URL=http://localhost:8080
SEARXNG_SECRET=

# ============================================================
# Server Binding
# ============================================================

BACKEND_BIND=127.0.0.1
BACKEND_PORT=3333
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000

# ============================================================
# Auth and Sessions
# ============================================================

# Generate: openssl rand -base64 64
KEPRIX_JWT_SECRET=GENERATE_RANDOM_64_CHARS_HERE
KEPRIX_SESSION_SECRET=GENERATE_RANDOM_64_CHARS_HERE
KEPRIX_TOTP_ISSUER=Keprix
KEPRIX_ALLOWED_ORIGINS=http://localhost:3000
KEPRIX_SESSION_TTL_DAYS=7
KEPRIX_REQUIRE_2FA=false
# Set automatically by keprix init if not present
KEPRIX_IP_HASH_SALT=
KEPRIX_CSP_EXTRA=
KEPRIX_REDACT_PRIVATE_IPS=false
KEPRIX_AUDIT_FAIL_ON_HIGH=false
# Admin bootstrap (set before first boot; read from .env only)
# KEPRIX_ADMIN_EMAIL=admin@example.com
# KEPRIX_ADMIN_PASSWORD=change_me_before_first_boot

KEPRIX_LOG_LEVEL=info

KEPRIX_SMTP_HOST=
KEPRIX_SMTP_PORT=587
KEPRIX_SMTP_USER=
KEPRIX_SMTP_PASS=
KEPRIX_EMAIL_FROM=
KEPRIX_RESEND_API_KEY=

# ============================================================
# Memory and RAG
# ============================================================

KEPRIX_CHROMADB_HOST=localhost
KEPRIX_CHROMADB_PORT=8100
KEPRIX_EMBEDDING_URL=
KEPRIX_EMBEDDING_API_KEY=
KEPRIX_EMBEDDING_MODEL=text-embedding-3-small
KEPRIX_FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
KEPRIX_FASTEMBED_CACHE_PATH=

# Notion integration token for RAG ingestion (optional if using MCP OAuth only)
KEPRIX_NOTION_TOKEN=

# ============================================================
# Messaging Channels
# ============================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# ============================================================
# Calendar
# ============================================================

KEPRIX_GOOGLE_CLIENT_ID=
KEPRIX_GOOGLE_CLIENT_SECRET=
KEPRIX_GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback
KEPRIX_CALDAV_URL=
KEPRIX_CALDAV_USERNAME=
KEPRIX_CALDAV_PASSWORD=

# ============================================================
# Vault
# ============================================================

# Generate: openssl rand -base64 32
KEPRIX_VAULT_KEY=GENERATE_RANDOM_32_CHARS_HERE

# ============================================================
# MCP
# ============================================================

KEPRIX_MCP_ALLOWED_SERVERS=

# ============================================================
# Governance (optional; disabled by default)
# ============================================================

KEPRIX_GOVERNANCE_ENABLED=false
KEPRIX_GOVERNANCE_PROVIDER=native
KEPRIX_GOVERNANCE_API_KEY=
KEPRIX_GOVERNANCE_WORKSPACE_ID=
KEPRIX_GOVERNANCE_ENDPOINT=
KEPRIX_GOVERNANCE_TRACE_EXPORT=false

# Comma-separated product extensions (e.g. scout)
KEPRIX_ACTIVE_EXTENSIONS=

# Comma-separated products built on Keprix (see config/products.example.yaml)
KEPRIX_ENABLED_PRODUCTS=
# KEPRIX_PRODUCTS_CONFIG=/path/to/products.yaml

# ============================================================
# Mutation Engine
# ============================================================

KEPRIX_GENERATED_TOOLS_DIR=/data/keprix/generated/tools
KEPRIX_GENERATED_SKILLS_DIR=/data/keprix/generated/skills
KEPRIX_MUTATION_ENABLED=true
KEPRIX_SANDBOX_TIMEOUT=30
KEPRIX_GAP_CONFIDENCE=0.7
KEPRIX_MUTATION_ADMIN_CHANNEL=web
KEPRIX_MUTATION_MAX_RETRIES=2
KEPRIX_MUTATION_REQUIRED_CHANNELS=web_ui,telegram
KEPRIX_TOOL_SIGNING_KEY=/data/keprix/secrets/tool-signing-key.pem
KEPRIX_TOOL_VERIFY_KEY=/data/keprix/secrets/tool-verify-key.pem
KEPRIX_MUTATION_REQUIRE_APPROVAL=true
KEPRIX_MUTATION_RATE_LIMIT=10
KEPRIX_MUTATION_TOOL_SYNTHESIS=true
KEPRIX_MUTATION_PROMPT_EVOLUTION=false
KEPRIX_MUTATION_SELF_CODING=false
KEPRIX_MUTATION_BRANCH_PREFIX=mutation/
KEPRIX_MUTATION_MERGE_STRATEGY=squash
KEPRIX_MUTATION_REPO_ROOT=.
KEPRIX_MUTATION_AUTO_APPROVE_THRESHOLD=0.85
KEPRIX_MUTATION_SYNTHESIS_MIN_CONFIDENCE=0.75
KEPRIX_MUTATION_REQUIRE_TESTS=true
KEPRIX_MUTATION_RETENTION_DAYS=365
KEPRIX_MUTATION_MAX_GENERATED_TOOLS=200
KEPRIX_MUTATION_PRUNE_AFTER_DAYS=90

# ============================================================
# Observability
# ============================================================

KEPRIX_LOG_LEVEL=info
# Anonymous usage telemetry (default off). Never sends conversation content or secrets.
KEPRIX_TELEMETRY=false
# KEPRIX_OTLP_ENDPOINT=http://localhost:4317

# ============================================================
# Billing (SaaS monetization)
# ============================================================

# Provider: stripe (requires STRIPE_SECRET_KEY) or mock mode with KEPRIX_BILLING_ENABLED=true
KEPRIX_BILLING_PROVIDER=
KEPRIX_BILLING_ENABLED=false
# Path to product billing.yaml (default: active extension or billing.example.yaml when KEPRIX_BILLING_USE_EXAMPLE=true)
# KEPRIX_BILLING_CONFIG=/path/to/billing.yaml
KEPRIX_BILLING_USE_EXAMPLE=false
KEPRIX_BILLING_CURRENCY=gbp
KEPRIX_BILLING_TAX_DEFAULT=0.20
KEPRIX_BILLING_ALLOW_UNSIGNED_WEBHOOKS=false

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_MODE=true

# ============================================================
# Data Directories
# ============================================================

KEPRIX_DATA_DIR=/data/keprix
KEPRIX_LOGS_DIR=/data/keprix/logs

# LLM usage and cost tracking (Prompt 145)
KEPRIX_LLM_USAGE_ENABLED=true
KEPRIX_LLM_USAGE_RETENTION_DAYS=90
KEPRIX_LLM_USAGE_SQLITE_FALLBACK=true

# ============================================================
# Upload Limits (bytes)
# ============================================================

# Route workspace /chat through the WEB_UI gateway stream (mutation + tools + LLM).
KEPRIX_CHAT_GATEWAY_STREAM=true
# Optional: run the full agent tool loop in web chat (requires a configured LLM provider).
# When unset, developer/admin/owner installs default to true; set false to force LLM-only chat.
# KEPRIX_WEB_UI_AGENT_LOOP=false
# Legacy sidecar gap bridge (Prompt 139). Default off; agent loop hook handles mutation.
KEPRIX_CHAT_MUTATION_SIDECAR=false
# Seconds to wait for mutation approval before ending a paused agent turn.
KEPRIX_MUTATION_APPROVAL_TIMEOUT=3600
# Keep /chat NDJSON stream open until mutation approve/reject (Prompt 28 parity).
KEPRIX_MUTATION_STREAM_WAIT_APPROVAL=true
# Optional LLM-only mutation trigger in addition to tool_miss (default off).
KEPRIX_MUTATION_LLM_TRIGGER=false

KEPRIX_CHAT_UPLOAD_MAX_BYTES=10485760
KEPRIX_DOCUMENT_UPLOAD_MAX_BYTES=26214400
KEPRIX_AUDIO_UPLOAD_MAX_BYTES=26214400

# Agent Apps (manifest-driven portable apps; see docs/features/agent-apps.md)
# KEPRIX_AGENT_APPS_DIR=~/.keprix/agent-apps
# KEPRIX_AGENT_APPS_CONFIG=config/agent_apps.yaml
# KEPRIX_AGENT_APP_RUN_RETENTION_DAYS=30
# KEPRIX_AGENT_APPS_ENABLED=true

# ============================================================
# GPU Support (Docker Compose overrides)
# ============================================================

# NVIDIA: COMPOSE_FILE=docker/docker-compose.yml:docker/gpu-nvidia.yml
# AMD:    COMPOSE_FILE=docker/docker-compose.yml:docker/gpu-amd.yml
