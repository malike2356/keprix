# Keprix - Environment Configuration
# Copy to .env and fill in your values. Never commit .env.
#
# All Keprix-specific variables use the KEPRIX_ prefix (uppercase).
# Provider API keys use their canonical upstream names so the same .env
# works with local model servers without modification.

# ============================================================
# Product
# ============================================================

KEPRIX_VERSION=0.16.0

# CLI / curl-installer data+config home (default: $HOME/.keprix).
# Uncomment to override. Docker Compose primarily uses KEPRIX_DATA_DIR bind mounts.
# KEPRIX_HOME=

# ============================================================
# Developer Mode
# ============================================================

# Set automatically by 'keprix init' when you confirm you are the owner.
# Do not set manually.
KEPRIX_DEVELOPER_MODE=false

# ============================================================
# LLM Providers
# ============================================================
# Minimum for first run: set at least one of OPENAI_API_KEY, ANTHROPIC_API_KEY, or GEMINI_API_KEY


KEPRIX_DEFAULT_PROVIDER=auto

# Web chat: inject read-only codebase map + docs into the system prompt (true/false).
KEPRIX_CODEBASE_AWARENESS=true
# Shared RAG corpus so Keprix can answer about its own capabilities/codebase.
# Indexed under user_id __keprix_self__ (override with KEPRIX_SELF_KNOWLEDGE_USER_ID).
KEPRIX_SELF_KNOWLEDGE_BOOTSTRAP=true
# Optional: KEPRIX_SELF_KNOWLEDGE_MAX_FILES (default 1500)
# Optional: KEPRIX_CODEBASE_ROOT
# Optional: KEPRIX_REPO_ROOT when the API runs outside the install directory
# Allow the agent to spawn MCP servers from the built-in catalog during tasks.
# When unset, falls back to mcp.auto_spawn_enabled in config.yaml (toggle via /admin/mcp).
KEPRIX_AUTO_MCP_SPAWN=false

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
LM_STUDIO_URL=http://host.docker.internal:1234/v1
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# ============================================================
# Database
# ============================================================
# REQUIRED: set strong passwords before docker compose up (no changeme in production).
# bash scripts/generate-production-env.sh

KEPRIX_DATABASE_URL=postgresql+asyncpg://keprix:REPLACE_ME_POSTGRES@localhost:5432/keprix
# CRM/outreach durable backend: auto | sqlite | postgres (default auto).
# auto uses Postgres when KEPRIX_DATABASE_URL connects and not under pytest
# (or when KEPRIX_CRM_FORCE_PG=1). Otherwise SQLite under data_dir.
# KEPRIX_CRM_BACKEND=auto
# KEPRIX_CRM_DB_PATH=
# KEPRIX_CRM_FORCE_PG=0

# ============================================================
# Outreach delivery (Soft Wall + providers)
# ============================================================
# Default Contabo/prod safety: keep dry-run on until SMTP/ESP is bound.
# KEPRIX_OUTREACH_DRY_RUN=1
# KEPRIX_OUTREACH_SOFT_WALL=1
# KEPRIX_OUTREACH_APPROVAL_EXPIRE_HOURS=72
# KEPRIX_OUTREACH_DRIFT_MINUTES=30
# KEPRIX_OUTREACH_FROM_EMAIL=
# Optional ESP (leave empty unless configured; never invent secrets):
# SENDGRID_API_KEY=
# SENDGRID_FROM=
# SENDGRID_WEBHOOK_VERIFY_KEY=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_FROM=
# MAILGUN_WEBHOOK_SIGNING_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SES_REGION=
# AWS_SES_FROM=
# AWS_SNS_TOPIC_ARN=

POSTGRES_PASSWORD=REPLACE_ME_POSTGRES
POSTGRES_BIND=127.0.0.1
POSTGRES_HOST_PORT=5432

# ============================================================
# Redis Cache
# ============================================================

KEPRIX_REDIS_URL=redis://:REPLACE_ME_REDIS@localhost:6379
REDIS_PASSWORD=REPLACE_ME_REDIS
REDIS_BIND=127.0.0.1
REDIS_HOST_PORT=6379

# ============================================================
# Web Search (SearXNG - self-hosted)
# ============================================================
# Start SearXNG: docker compose -f docker-compose.searxng.yml up -d
# Then set SEARXNG_URL in Settings -> Web search (or here for non-UI setups).

SEARXNG_BIND=127.0.0.1
SEARXNG_PORT=8080
SEARXNG_URL=http://localhost:8080
KEPRIX_SEARXNG_URL=http://localhost:8080
SEARXNG_SECRET=

# ============================================================
# Server Binding
# ============================================================

BACKEND_BIND=127.0.0.1
BACKEND_PORT=3333
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000

# ============================================================
# Auth and Sessions
# ============================================================

# Auth on by default. Set false only for locked-down local/dev experiments.
AUTH_ENABLED=true
# Multi-user off by default (single-operator). Set true to allow additional accounts.
KEPRIX_MULTI_USER=false

# REQUIRED for production. Generate with:
#   bash scripts/generate-production-env.sh --domain https://app.example.com
# Do not leave GENERATE_RANDOM_* or changeme values on a public host.
KEPRIX_JWT_SECRET=GENERATE_RANDOM_64_CHARS_HERE
KEPRIX_SESSION_SECRET=GENERATE_RANDOM_64_CHARS_HERE
KEPRIX_TOTP_ISSUER=Keprix
# Comma-separated browser origins (include https://your.domain)
KEPRIX_ALLOWED_ORIGINS=http://localhost:3000
KEPRIX_SESSION_TTL_DAYS=7
# Shared HMAC secret for Carina Agent Studio -> Keprix Visual Playbook Studio handoff JWTs
KEPRIX_HANDOFF_SECRET=GENERATE_RANDOM_32_CHARS_HERE
# Shared bearer token for Carina/Aiva -> Keprix agent contract (POST /carina/agent/run)
CARINA_KEPRIX_SHARED_TOKEN=
# Optional comma-separated provider:model fallbacks for the Carina bridge
# CARINA_KEPRIX_FALLBACK_MODELS=openai:gpt-4.1-mini,openrouter:openrouter/auto
KEPRIX_REQUIRE_2FA=false
# Set automatically by keprix init if not present
KEPRIX_IP_HASH_SALT=
KEPRIX_CSP_EXTRA=
KEPRIX_REDACT_PRIVATE_IPS=false
KEPRIX_AUDIT_FAIL_ON_HIGH=false
# Admin bootstrap (set before first boot; read from .env only).
# Optional KEPRIX_ADMIN_EMAIL (example: admin@example.com)
# Optional KEPRIX_ADMIN_PASSWORD (change before first boot on shared hosts)
# Never print admin password on shared hosts (install.sh honors this; default off)
KEPRIX_SHOW_ADMIN_PASSWORD=0

# Immediate peer CIDRs allowed to supply X-Forwarded-For / X-Forwarded-Proto
# (Caddy/nginx on the same host: 127.0.0.1,::1; Cloudflare: use tunnel/origin IPs)
KEPRIX_TRUSTED_PROXIES=127.0.0.1,::1

KEPRIX_LOG_LEVEL=info

KEPRIX_SMTP_HOST=
KEPRIX_SMTP_PORT=587
KEPRIX_SMTP_USER=
KEPRIX_SMTP_PASS=
KEPRIX_EMAIL_FROM=
KEPRIX_RESEND_API_KEY=

# ============================================================
# Memory and RAG
# ============================================================

KEPRIX_CHROMADB_HOST=localhost
KEPRIX_CHROMADB_PORT=8100
KEPRIX_EMBEDDING_URL=
KEPRIX_EMBEDDING_API_KEY=
KEPRIX_EMBEDDING_MODEL=text-embedding-3-small
KEPRIX_FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
KEPRIX_FASTEMBED_CACHE_PATH=

# Notion integration token for RAG ingestion (optional if using MCP OAuth only)
KEPRIX_NOTION_TOKEN=

# Companies House Public Data API (search + company profiles)
COMPANIES_HOUSE_API_KEY=
KEPRIX_COMPANIES_HOUSE_ENABLED=1

# ============================================================
# Messaging Channels
# ============================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# ============================================================
# Calendar
# ============================================================

KEPRIX_GOOGLE_CLIENT_ID=
KEPRIX_GOOGLE_CLIENT_SECRET=
KEPRIX_GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# Google Workspace connector (OAuth desktop app, token stored outside repo)
KEPRIX_GWS_ENABLED=0
GOOGLE_WORKSPACE_CREDENTIALS_PATH=
GOOGLE_WORKSPACE_TOKEN_PATH=
GOOGLE_WORKSPACE_BRIDGE_CMD=
GOOGLE_WORKSPACE_USE_GWS_CLI=0
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_MODE=0
KEPRIX_GITHUB_CLIENT_ID=
KEPRIX_GITHUB_CLIENT_SECRET=

# ============================================================
# GitHub agent-sync (optional bootstrap only)
# ============================================================
# Prefer Settings -> Agent sync in the GUI. Env is optional for headless hosts.
# AGENT_SYNC_GITHUB_ENABLED=false
# AGENT_SYNC_GITHUB_TOKEN=
# AGENT_SYNC_GITHUB_OWNER=malike2356
# AGENT_SYNC_GITHUB_REPO=agent-sync
# AGENT_SYNC_GITHUB_BRANCH=main
# AGENT_SYNC_GITHUB_PRODUCT=keprix

# ============================================================
# Syncthing Obsidian vault (optional bootstrap only)
# ============================================================
# Prefer Settings -> Syncthing in the GUI. Vault only; do not share agent-sync paths.
# SYNCTHING_API_KEY=
# KEPRIX_SYNCTHING_API_KEY=
# SYNCTHING_GUI_PORT=8384
# SYNCTHING_SYNC_PORT=22000
KEPRIX_OIDC_CLIENT_ID=
KEPRIX_OIDC_CLIENT_SECRET=
KEPRIX_OIDC_ISSUER=
KEPRIX_OIDC_NAME=
KEPRIX_SSO_REDIRECT_URI=http://localhost:3333/api/auth/sso/callback
KEPRIX_FRONTEND_URL=http://127.0.0.1:3000
KEPRIX_CALDAV_URL=
KEPRIX_CALDAV_USERNAME=
KEPRIX_CALDAV_PASSWORD=

# ============================================================
# Vault
# ============================================================

# Generate: openssl rand -base64 32 (or use scripts/generate-production-env.sh)
KEPRIX_VAULT_KEY=GENERATE_RANDOM_32_CHARS_HERE

# ============================================================
# MCP
# ============================================================

KEPRIX_MCP_ALLOWED_SERVERS=
# Leave empty for built-in local Graphiti store, or set an external MCP URL.
GRAPHITI_MCP_URL=
KEPRIX_GRAPHITI_ENABLED=1

# ============================================================
# Governance (optional; disabled by default)
# ============================================================

KEPRIX_GOVERNANCE_ENABLED=false
KEPRIX_GOVERNANCE_PROVIDER=native
KEPRIX_GOVERNANCE_API_KEY=
KEPRIX_GOVERNANCE_WORKSPACE_ID=
KEPRIX_GOVERNANCE_ENDPOINT=
KEPRIX_GOVERNANCE_TRACE_EXPORT=false

# Scout integration (optional; uses governance endpoint/key when unset)
SCOUT_ENABLED=false
SCOUT_API_KEY=
SCOUT_ENDPOINT=https://console.labyrinthscout.com
SCOUT_API_URL=
SCOUT_REDIS_URL=
KEPRIX_SCOUT_PRODUCT=keprix
# Aiva/Carina agent Scout hooks (K06)
KEPRIX_SCOUT_AGENT_ID=
KEPRIX_SCOUT_AGENT_ID_PREFIX=keprix-aiva
KEPRIX_SCOUT_KILL_TOKEN=
KEPRIX_SCOUT_STRICT=false
KEPRIX_SCOUT_TOOL_BURST_LIMIT=40
KEPRIX_SCOUT_WARDEN_ENABLED=0
KEPRIX_SCOUT_WARDEN_URL=
KEPRIX_SCOUT_WARDEN_TOKEN=

# Channel Shield (shared inbound protection; optional)
CHANNEL_SHIELD_ENABLED=false
CHANNEL_SHIELD_SMTP_HOST=0.0.0.0
CHANNEL_SHIELD_SMTP_PORT=2525
CHANNEL_SHIELD_CLAMAV_SOCKET=
CHANNEL_SHIELD_YARA_RULES_DIR=
CHANNEL_SHIELD_WEB_ORIGINS=
CHANNEL_SHIELD_WEB_EMBED_KEY=
# memory | durable (default). Durable uses Postgres when KEPRIX_DATABASE_URL is set, else SQLite.
# Optional: CHANNEL_SHIELD_STORE (memory or durable)
# Optional: CHANNEL_SHIELD_SQLITE_PATH for durable SQLite fallback

# Comma-separated product extensions (e.g. scout)
KEPRIX_ACTIVE_EXTENSIONS=

# Comma-separated products built on Keprix (see config/products.example.yaml)
KEPRIX_ENABLED_PRODUCTS=
# Optional: KEPRIX_PRODUCTS_CONFIG path to products.yaml

# ============================================================
# Mutation Engine
# ============================================================

KEPRIX_GENERATED_TOOLS_DIR=/data/keprix/generated/tools
KEPRIX_GENERATED_SKILLS_DIR=/data/keprix/generated/skills
KEPRIX_MUTATION_ENABLED=true
KEPRIX_SANDBOX_TIMEOUT=30
KEPRIX_GAP_CONFIDENCE=0.7
KEPRIX_MUTATION_ADMIN_CHANNEL=web
KEPRIX_MUTATION_MAX_RETRIES=2
KEPRIX_MUTATION_REQUIRED_CHANNELS=web_ui,telegram

# Aiva uses a low-latency model independently of the engineering agent default.
AIVA_PROVIDER=deepseek
AIVA_MODEL=deepseek-v4-flash
# Keep Flash in low-latency non-thinking mode. Enable only for complex Aiva work.
AIVA_DEEPSEEK_THINKING=false
# Optional JSON object keyed by workspace ID. Values may be "provider:model"
# strings or objects with provider and model keys.
AIVA_WORKSPACE_MODELS={}
KEPRIX_TOOL_SIGNING_KEY=/data/keprix/secrets/tool-signing-key.pem
KEPRIX_TOOL_VERIFY_KEY=/data/keprix/secrets/tool-verify-key.pem
KEPRIX_MUTATION_REQUIRE_APPROVAL=true
KEPRIX_MUTATION_RATE_LIMIT=10
KEPRIX_MUTATION_TOOL_SYNTHESIS=true
KEPRIX_MUTATION_PROMPT_EVOLUTION=false
KEPRIX_MUTATION_SELF_CODING=false
KEPRIX_MUTATION_BRANCH_PREFIX=mutation/
KEPRIX_MUTATION_MERGE_STRATEGY=squash
KEPRIX_MUTATION_REPO_ROOT=.
KEPRIX_MUTATION_AUTO_APPROVE_THRESHOLD=0.85
KEPRIX_MUTATION_SYNTHESIS_MIN_CONFIDENCE=0.75
KEPRIX_MUTATION_REQUIRE_TESTS=true
KEPRIX_MUTATION_RETENTION_DAYS=365
KEPRIX_MUTATION_MAX_GENERATED_TOOLS=200
KEPRIX_MUTATION_PRUNE_AFTER_DAYS=90

# ============================================================
# Observability
# ============================================================

KEPRIX_LOG_LEVEL=info
# Anonymous usage telemetry (default off). Never sends conversation content or secrets.
KEPRIX_TELEMETRY=false
# Optional: KEPRIX_OTLP_ENDPOINT (example http://localhost:4317)

# ============================================================
# Billing (SaaS monetization)
# ============================================================

# Provider: stripe (requires STRIPE_SECRET_KEY) or mock mode (KEPRIX_BILLING_ENABLED true)
KEPRIX_BILLING_PROVIDER=
KEPRIX_BILLING_ENABLED=false
# Path to product billing.yaml (default: active extension or billing.example.yaml when use-example is true)
# Optional: KEPRIX_BILLING_CONFIG path to billing.yaml
KEPRIX_BILLING_USE_EXAMPLE=false
KEPRIX_BILLING_CURRENCY=gbp
KEPRIX_BILLING_TAX_DEFAULT=0.20
KEPRIX_BILLING_ALLOW_UNSIGNED_WEBHOOKS=false

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_MODE=true

# ============================================================
# Data Directories
# ============================================================

KEPRIX_DATA_DIR=/data/keprix
KEPRIX_LOGS_DIR=/data/keprix/logs

# Docker Compose bind-mounts host ~/.keprix (mode 0700). Remap the container
# keprix user to the host owner so Brain/workspace paths are readable.
# Defaults to 1000:1000 in docker/docker-compose.yml; override to match `id -u`/`id -g`.
# KEPRIX_UID=1000
# KEPRIX_GID=1000
# PUID/PGID aliases are also accepted by the backend entrypoint.

# Inside Docker, prefer the bind-mounted vault path (not a host /home/<user>/... path).
# KEPRIX_VAULT_ROOT=/home/keprix/.keprix/vault

# LLM usage and cost tracking (Prompt 145)
KEPRIX_LLM_USAGE_ENABLED=true
KEPRIX_LLM_USAGE_RETENTION_DAYS=90
KEPRIX_LLM_USAGE_SQLITE_FALLBACK=true

# ============================================================
# Upload Limits (bytes)
# ============================================================

# Route workspace /chat through the WEB_UI gateway stream (mutation + tools + LLM).
KEPRIX_CHAT_GATEWAY_STREAM=true
# Optional: run the full agent tool loop in web chat (requires a configured LLM provider).
# When unset, developer/admin/owner installs default to true; set false to force LLM-only chat.
# Optional: KEPRIX_WEB_UI_AGENT_LOOP (false forces LLM-only chat)
# Legacy sidecar gap bridge (Prompt 139). Default off; agent loop hook handles mutation.
KEPRIX_CHAT_MUTATION_SIDECAR=false
# Seconds to wait for mutation approval before ending a paused agent turn.
KEPRIX_MUTATION_APPROVAL_TIMEOUT=3600
# Keep /chat NDJSON stream open until mutation approve/reject (Prompt 28 parity).
KEPRIX_MUTATION_STREAM_WAIT_APPROVAL=true
# Optional LLM-only mutation trigger in addition to tool_miss (default off).
KEPRIX_MUTATION_LLM_TRIGGER=false

KEPRIX_CHAT_UPLOAD_MAX_BYTES=10485760
KEPRIX_DOCUMENT_UPLOAD_MAX_BYTES=26214400
KEPRIX_AUDIO_UPLOAD_MAX_BYTES=26214400

# Notebook research bridge (optional external sidecar; Quick Notebook is native)
KEPRIX_NOTEBOOK_RESEARCH_ENABLED=true
NOTEBOOKLM_BRIDGE_CMD=
NOTEBOOKLM_MCP_URL=

# Design live preview
KEPRIX_DESIGN_PREVIEW_ENABLED=true
# Optional: KEPRIX_WORKSPACE_ROOT path

# Agent Apps (manifest-driven portable apps; see docs/features/agent-apps.md)
# Optional: KEPRIX_AGENT_APPS_DIR (default ~/.keprix/agent-apps)
# Optional: KEPRIX_AGENT_APPS_CONFIG (default config/agent_apps.yaml)
# Optional: KEPRIX_AGENT_APP_RUN_RETENTION_DAYS (default 30)
# Optional: KEPRIX_AGENT_APPS_ENABLED (default true)

# ============================================================
# GPU Support (Docker Compose overrides)
# ============================================================

# NVIDIA: set COMPOSE_FILE to docker/docker-compose.yml:docker/gpu-nvidia.yml
# AMD: set COMPOSE_FILE to docker/docker-compose.yml:docker/gpu-amd.yml

# Public HTTPS origin (Stripe returns, links, CORS companion to KEPRIX_ALLOWED_ORIGINS)
KEPRIX_INSTANCE_URL=http://localhost:3000

# ============================================================
# Production VPS (see docs/operations/vps-deploy.md)
# ============================================================
# bash scripts/generate-production-env.sh --domain https://app.example.com
# bash scripts/deploy-server.sh --bootstrap --domain app.example.com --profile compose
# Optional: pin images with KEPRIX_IMAGE_TAG (example v0.16.0)
# Prod compose overlay removes Postgres/Redis host ports.
