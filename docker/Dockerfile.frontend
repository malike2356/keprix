FROM node:22-alpine AS deps
WORKDIR /app/frontend
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM node:22-alpine AS builder
WORKDIR /app/frontend
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY --from=deps /app/frontend/node_modules ./node_modules
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/next.config.ts frontend/tsconfig.json frontend/postcss.config.mjs frontend/eslint.config.mjs frontend/next-env.d.ts frontend/tailwind.voice.config.ts frontend/vitest.config.ts ./
COPY frontend/public ./public
COPY frontend/src ./src
COPY ui/design-system /app/ui/design-system
COPY CHANGELOG.md /app/CHANGELOG.md
ENV NEXT_TELEMETRY_DISABLED=1
# Same-origin /api in the browser; rewrite target is the Docker backend service.
ARG BACKEND_REWRITE_URL=http://keprix-backend:3333
ENV BACKEND_REWRITE_URL=$BACKEND_REWRITE_URL
ENV NEXT_PUBLIC_API_URL=
ENV NEXT_PUBLIC_CE_API_URL=
RUN pnpm exec next build

FROM node:22-alpine AS runner
WORKDIR /app/frontend
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 keprix && \
    adduser --system --uid 1001 keprix && \
    apk add --no-cache wget

COPY --from=builder --chown=keprix:keprix /app/frontend/.next/standalone ./
COPY --from=builder --chown=keprix:keprix /app/frontend/.next/static ./.next/static
COPY --from=builder --chown=keprix:keprix /app/frontend/public ./public
COPY --from=builder --chown=keprix:keprix /app/ui/design-system /app/ui/design-system
COPY --from=builder --chown=keprix:keprix /app/CHANGELOG.md /app/CHANGELOG.md

USER keprix
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=10 \
  CMD wget -q --spider http://127.0.0.1:3000/ || exit 1

CMD ["node", "server.js"]
