  "fontFamily": "\"Inter\", \"Segoe UI\", system-ui, -apple-system, sans-serif",
  "fontFamilyMono": "\"JetBrains Mono\", \"Fira Code\", ui-monospace, monospace",
  "scale": {
    "xs": "0.75rem",
    "sm": "0.875rem",
    "base": "0.9375rem",
    "lg": "1.125rem",
    "xl": "1.25rem",
